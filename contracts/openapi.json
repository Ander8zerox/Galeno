  "components": {
    "schemas": {
      "PacienteRequest": {
        "type": "object",
        "properties": {
          "tipoDocumento": {
            "type": "string",
            "minLength": 1,
            "pattern": "CC|TI|CE|PA|RC|PT|MS|AS"
          },
          "numeroDocumento": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          "nombres": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "apellidos": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "sexo": {
            "type": "string",
            "minLength": 1,
            "pattern": "F|M|I"
          },
          "telefono": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 190,
            "minLength": 0
          },
          "alergias": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "antecedentes": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          }
        },
        "required": [
          "apellidos",
          "fechaNacimiento",
          "nombres",
          "numeroDocumento",
          "sexo",
          "tipoDocumento"
        ]
      },
      "PacienteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tipoDocumento": {
            "type": "string"
          },
          "numeroDocumento": {
            "type": "string"
          },
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "edad": {
            "type": "integer",
            "format": "int32"
          },
          "sexo": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "alergias": {
            "type": "string"
          },
          "antecedentes": {
            "type": "string"
          }
        }
      },
      "ActualizarMiembro": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "MEDICO",
                "SECRETARIO"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "estado": {
            "type": "string",
            "enum": [
              "ACTIVA",
              "SUSPENDIDA"
            ]
          },
          "registroMedico": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          }
        },
        "required": [
          "estado",
          "roles"
